<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <OutDir>.\..\..\..\..\..\Bin\$(PlatformName)\$(MsvcVer)\$(ProjectName)\</OutDir>
    <IntDir>.\..\..\..\..\..\Obj\$(PlatformName)\$(MsvcVer)\$(Configuration)\$(ProjectName)\</IntDir>
    <_PropertySheetDisplayName>GFx_App_Kits_VS18</_PropertySheetDisplayName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>..\..\..\..\..\Include;..\..\..\..\..\Src;..\..\..\..\..\Apps\Samples\Common;..\..\..\..\..\3rdParty\fmod-2.03.13\core\inc;..\..\..\..\..\3rdParty\expat-2.9.0\lib;..\..\..\..\..\3rdParty\zlib-1.3.2;..\..\..\..\..\3rdParty\glext;..\..\..\..\..\3rdParty\jpeg-10;..\..\..\..\..\3rdParty\nvidia;..\..\..\..\..\3rdParty\pcre;$(DXSDK_DIR)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/w44264</AdditionalOptions>
      <PreprocessorDefinitions>WIN32;_WINDOWS;SF_BUILD_STATICLIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d3d9.lib;libgfx.lib;libgfx_as2.lib;libgfx_as3.lib;libgfx_air.lib;libjpeg.lib;libpng.lib;zlib.lib;libcurl.lib;Wldap32.lib;pcre.lib;Xinput9_1_0.lib;winmm.lib;odbc32.lib;odbccp32.lib;imm32.lib;dbghelp.lib;libgfx_sfd2video.lib;libgfx_ffmpegvideo.lib;cri_mana_pcx64.lib;cri_atom_pcx64.lib;cri_file_system_pcx64.lib;cri_base_pcx64.lib;cri_framework_pcx64.lib;mfplat.lib;mfuuid.lib;avcodec.lib;avdevice.lib;avfilter.lib;avformat.lib;avutil.lib;aom.lib;dav1d.lib;fdk-aac.lib;mp3lame.lib;libx264.lib;libx265.lib;hdr10plus.lib;opus.lib;PPA.lib;vpl.lib;vpx.lib;zimg.lib;z.lib;libbz2.lib;SDL2-static.lib;swresample.lib;swscale.lib;bcrypt.lib;ncrypt.lib;crypt32.lib;secur32.lib;setupapi.lib;cfgmgr32.lib;version.lib;uuid.lib;strmiids.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>..\..\..\..\..\Lib\x64\$(MsvcVer)\$(ConfigShort)\;..\..\..\..\..\3rdParty\FFMpeg\lib;..\..\..\..\..\3rdParty\curl-8.23.0\Lib\x64\$(MsvcVer)\Release\;..\..\..\..\..\3rdParty\libpng-1.6.59\Lib\x64\$(MsvcVer)\Release;..\..\..\..\..\3rdParty\zlib-1.3.2\Lib\x64\$(MsvcVer)\Release;..\..\..\..\..\3rdParty\jpeg-10\Lib\x64\$(MsvcVer)\Release;..\..\..\..\..\3rdParty\cri2019\pc\libs\$(Platform);..\..\..\..\..\3rdParty\fmod-2.03.13\core\lib\$(Platform);..\..\..\..\..\3rdParty\fmod-2.03.13\fsbank\lib\$(Platform);..\..\..\..\..\3rdParty\fmod-2.03.13\studio\lib\$(Platform);..\..\..\..\..\3rdParty\pcre2-10.49\Lib\x64\$(MsvcVer)\Release;$(LibraryPath);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <!--
    Debug configurations link Release-built third-party archives (FFmpeg / x265 / CRI ...),
    whose objects carry a /DEFAULTLIB:LIBCMT directive. Without this the linker pulls both
    LIBCMT and LIBCMTD and reports
        LINK : warning LNK4098: default library "LIBCMT" conflicts with other libraries
    and the process ends up with two CRT heaps (memory allocated inside a third-party
    library cannot be freed by the app, and vice versa). Ignoring LIBCMT keeps the whole
    link on the debug CRT, which removes both the warning and the mixed-heap hazard.
    Release/Shipping configurations keep the release CRT and are not affected.
  -->
  <ItemDefinitionGroup Condition="$(Configuration.Contains('Debug'))">
    <Link>
      <AdditionalOptions>/NODEFAULTLIB:LIBCMT %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
