		PreprocessorDefinitions="WIN32;_WINDOWS"
	/>
	<Tool
		Name="VCLinkerTool"
		AdditionalDependencies="libjpeg.lib libpng.lib zlib.lib expat.lib pcre.lib libcurl.lib Wldap32.lib XInput.lib winmm.lib odbc32.lib odbccp32.lib imm32.lib gtest$(ConfigLetter).lib dbghelp.lib"
		AdditionalLibraryDirectories="&quot;..\..\..\..\..\Lib\$(PlatformName)\$(MsvcVer)\$(ConfigShort)\&quot;;&quot;..\..\..\..\..\3rdParty\libpng-1.6.53\Lib\$(PlatformName)\$(MsvcVer)\Release&quot;;&quot;..\..\..\..\..\3rdParty\zlib-1.3.2\Lib\$(PlatformName)\$(MsvcVer)\Release&quot;;&quot;..\..\..\..\..\3rdParty\curl-8.22.0\lib\$(PlatformName)\$(MsvcVer)\Release&quot;;&quot;..\..\..\..\..\3rdParty\jpeg-10\Lib\$(PlatformName)\$(MsvcVer)\Release&quot;;&quot;..\..\..\..\..\3rdParty\pcre2-10.48\Lib\$(PlatformName)\$(MsvcVer)\Release&quot;;&quot;..\..\..\..\..\3rdParty\cri2019\pc\libs\$(PlatformName)&quot;;&quot;..\..\..\..\..\3rdParty\fmod\pc\$(PlatformName)\lib&quot;;&quot;..\..\..\..\..\3rdParty\expat-2.8.4\lib\$(PlatformName)\$(MsvcVer)\Release&quot;;&quot;..\..\..\..\..\3rdParty\gtest-1.6.0\lib\$(PlatformName)\$(MsvcVer)\$(ConfigShort)\&quot;;&quot;$(DXSDK_DIR)\lib\x$(BitSet)&quot;"
	/>
</VisualStudioPropertySheet>
